{
  "name": "hibotchi",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types",
    "check": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply hibotchi --local",
    "db:migrate:remote": "wrangler d1 migrations apply hibotchi --remote",
    "deploy": "wrangler deploy --outdir dist",
    "dev": "wrangler dev --test-scheduled",
    "fmt": "oxfmt",
    "fmt:fix": "oxfmt --fix",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "register:commands": "node --env-file=.dev.vars --import tsx scripts/register-commands.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.12.18"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.15.0",
    "@types/node": "^25.6.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.5",
    "wrangler": "^4.85.0"
  }
}
